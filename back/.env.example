# Supabase PostgreSQL Configuration
SUPABASE_HOST=your-project-ref.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your-database-password

# JWT Configuration (for auth-service and api-gateway)
# IMPORTANT: Use a strong secret key (at least 32 characters) in production
JWT_SECRET=your-jwt-secret-key-at-least-32-characters
JWT_EXPIRATION=3600000

# Kafka Configuration (for async messaging)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Service Ports
EUREKA_PORT=8761
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
CONCERT_SERVICE_PORT=8082
RESERVATION_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
